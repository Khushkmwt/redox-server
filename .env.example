# Redox Server Configuration Example

# Network & Server
HOST=127.0.0.1
PORT=6379
MAX_CONNECTIONS=100
TIMEOUT=0

# Authentication (Leave empty or unset for unauthenticated mode)
REQUIREPASS=

# Memory & Eviction (e.g. 256mb, 1gb, 0 for unlimited)
MAX_MEMORY=0
# Eviction policy: noeviction | allkeys-lru
EVICTION_POLICY=noeviction

# Persistence
DUMP_PATH=./data/dump.json

# Logging: DEBUG | INFO | WARN | ERROR | SILENT
LOG_LEVEL=INFO
